# ==============================================================================
# MAXICONECTA - VARIABLES DE ENTORNO GLOBALES
# ==============================================================================

# Entorno: development | staging | production
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# SUPABASE / POSTGRESQL
# ------------------------------------------------------------------------------
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://tu-proyecto.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maxiconecta

# ------------------------------------------------------------------------------
# REDIS (Caché de Carrito y Reservas de Stock)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# SEGURIDAD Y JWT (Supabase Auth)
# ------------------------------------------------------------------------------
JWT_SECRET=tu-jwt-secret-de-supabase
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# TOPOLOGÍA DE MICROSERVICIOS INTERNOS (Para el API Gateway)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
MS_CATALOGO_URL=http://localhost:8001
MS_POS_URL=http://localhost:8002
MS_CARRITO_URL=http://localhost:8003
MS_CLIENTES_URL=http://localhost:8004
MS_ORDENES_URL=http://localhost:8005
MS_REPORTES_URL=http://localhost:8006

# ------------------------------------------------------------------------------
# CONTRATOS ERP EXTERNOS (Simulación o Producción RIO)
# ------------------------------------------------------------------------------
ERP_INVENTARIOS_URL=http://localhost:9001
ERP_PAGOS_URL=http://localhost:9002
ERP_CONTABILIDAD_URL=http://localhost:9003
ERP_CRM_URL=http://localhost:9004
ERP_ENTREGAS_URL=http://localhost:9005
ERP_PRODUCCION_URL=http://localhost:9006
ERP_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------------------------
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
